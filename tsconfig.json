{
	"compilerOptions": {
		"target": "ESNext",
		"jsx": "react-jsx",
		"lib": [
			"ESNext"
		],
		"moduleDetection": "force",
		"module": "ESNext",
		/* Bundler mode */
		"moduleResolution": "bundler",
		"paths": {
			"@/*": [
				"./*"
			],
			"@server/*": [
				"./server/*"
			],
			"@convex/*": [
				"./convex/*"
			],
			"@shared/*": [
				"./shared/*"
			]
		},
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"strict": true,
		"noFallthroughCasesInSwitch": true,
		"noEmit": true,
		"forceConsistentCasingInFileNames": true,
		"verbatimModuleSyntax": true,
		/* Linting */
		"skipLibCheck": true
	}
}
