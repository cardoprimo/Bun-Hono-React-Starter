{
  "name": "bun-starter",
  "type": "module",
  "module": "server/index.ts",
  "scripts": {
    "start": "bun server/index.ts",
    "dev": "bun --watch server/index.ts",
    "test": "concurrently -m 1 -c auto bun:db:reset  bun:test:vitest",
    "test:vitest": "vitest run",
    "test:watch": "vitest watch",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "peerDependencies": {
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@clerk/backend": "^1.25.3",
    "@clerk/clerk-react": "^5.25.0",
    "@hono/clerk-auth": "^2.0.0",
    "@hono/zod-validator": "^0.1.11",
    "@libsql/client": "^0.14.0",
    "@openauthjs/openauth": "latest",
    "@t3-oss/env-core": "latest",
    "@tanstack/react-router": "^1.99.13",
    "convex": "^1.21.0",
    "convex-helpers": "^0.1.73",
    "drizzle-orm": "^0.39.2",
    "drizzle-zod": "^0.5.1",
    "hono": "^3.12.12",
    "server": "react-dom/server",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.11.0",
    "@eslint-react/eslint-plugin": "^1.37.3",
    "@flydotio/dockerfile": "latest",
    "@types/bun": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.23.0",
    "eslint-plugin-format": "^1.0.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "vitest": "latest"
  },
  "vitest": {
    "maxConcurrency": 1
  }
}
